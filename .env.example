# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=financas

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret
# Opcional: `iss` esperado no token quando difere de SUPABASE_AUTH_URL + /auth/v1 (Supabase local visto do Docker)
# SUPABASE_JWT_ISSUER=http://127.0.0.1:64321/auth/v1

# Notificações de limite (e-mail via Resend API)
EMAIL_ALERTS_ENABLED=false
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Placo <onboarding@resend.dev>
ALERT_CHECK_INTERVAL=1800

# Chaves Fernet (separadas por vírgula) que cifram a chave Pluggy dos usuários no banco.
# A primeira cifra, todas decifram (rotação). Obrigatória: o backend não sobe sem ela.
# Gerar: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guardar no EnvVault (envvault), nunca no repositório. Perder a chave = perder as chaves Pluggy salvas.
PLUGGY_KEY_ENCRYPTION_KEYS=

# Deploy (backend)
# ENVIRONMENT=production desativa /docs, /redoc e /openapi.json
ENVIRONMENT=development
# Origens CORS permitidas, separadas por vírgula (vazio = defaults localhost de dev)
CORS_ORIGINS=http://localhost:8087,http://localhost:8080,http://localhost:8005
# Domínio público (nginx de produção / certbot)
DOMAIN=example.com
