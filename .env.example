# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=financas

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Notificações de limite (e-mail via Resend API)
EMAIL_ALERTS_ENABLED=false
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Placo <onboarding@resend.dev>
ALERT_CHECK_INTERVAL=1800

# Deploy (backend)
# ENVIRONMENT=production desativa /docs, /redoc e /openapi.json
ENVIRONMENT=development
# Origens CORS permitidas, separadas por vírgula (vazio = defaults localhost de dev)
CORS_ORIGINS=http://localhost:8087,http://localhost:8080,http://localhost:8005
# Domínio público (nginx de produção / certbot)
DOMAIN=example.com
